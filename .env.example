# Neat — optional API keys.
#
# Copy this file to ~/Neat/.env and fill in the values. Variable names match
# Sky's .env.local exactly, so they can be copied straight across.
#
#   cp .env.example ~/Neat/.env
#
# All of these are optional. Without them Neat still downloads, transcribes and
# reads on-screen text — it just does that work entirely on-device.
#
# Note: a key in a dotfile is plain text on disk. The Keychain is the safer
# store and the app still prefers it when a key is present there; this file
# exists because it is faster to paste into. Keys entered in the app's key
# sheet go to the Keychain, never here.

# Extracts links, tools and resources out of transcripts, on-screen text and
# frames. Without it, the extract stage is skipped.
GROQ_API_KEY=

# Pushes extracted resources into your Notion Resources database.
# Both are needed; without them the Notion button is disabled.
NOTION_TOKEN=
NOTION_RESOURCES_DB_ID=

# Optional fallback for frames the on-device reader could not handle —
# low-confidence or non-Latin text. Vision does the rest locally.
ANTHROPIC_API_KEY=
